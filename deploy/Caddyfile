{
    admin off
    auto_https off
}
:8080 {
    root * /srv
    encode zstd gzip
    @assets path /static/*
    header @assets Cache-Control "public, max-age=31536000, immutable"
    @html not path /static/*
    header @html Cache-Control "no-cache"
    header X-Robots-Tag "noindex, nofollow"
    try_files {path} /index.html
    file_server
}
