{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] },
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": true,
    "types": ["node", "@playwright/test"]
  },
  "include": [
    "playwright*.config.ts",
    "tests/e2e/**/*.ts",
    "tests/e2e/**/*.mjs",
    "tests/pivotTable/**/*.ts",
    "tests/workUnitOverrides/**/*.ts",
    "tests/*.spec.ts"
  ],
  "exclude": ["node_modules", "tests/e2e/live/generated/**"]
}
