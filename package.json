{
  "name": "epoca-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build --base=/__PUBLIC_URL__/",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "husky install",
    "lint": "eslint .",
    "lint-fix": "eslint --fix .",
    "format": "prettier --write '{src,test}/**/*.{ts,tsx,js,json,md}'",
    "format:check": "prettier --check '{src,test}/**/*.{ts,tsx,js,json,md}'",
    "optimize-svg": "svgo -f src/theme/assets/svg/",
    "typecheck": "tsc --noEmit",
    "verify:toolchain": "node scripts/verify-toolchain-pins.mjs",
    "test:e2e": "playwright test --project=mock-chromium",
    "test:e2e:ci": "node scripts/run-e2e-aggregate.mjs ci",
    "test:e2e:all": "node scripts/run-e2e-aggregate.mjs all",
    "test:e2e:mr": "node scripts/run-e2e-aggregate.mjs ci",
    "test:e2e:mock:oauth-client": "node scripts/e2e/run-oauth-client-mock.mjs",
    "test:e2e:full": "node scripts/run-e2e-aggregate.mjs all",
    "test:e2e:live": "playwright test -c playwright.live.config.ts --project=live-chromium --grep @live",
    "test:e2e:live:oauth-client": "node scripts/e2e/run-oauth-client-live.mjs",
    "test:e2e:local-proxy": "playwright test -c playwright.local-proxy.config.ts --project=local-proxy-chromium --grep @local-proxy",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "validate:e2e": "node scripts/validate-e2e-coverage.mjs && node scripts/validate-e2e-tiers.mjs",
    "test-e2e:work-unit-overrides": "playwright test --config=playwright.work-unit-overrides.config.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/modifiers": "^7.0.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@formatjs/fast-memoize": "^2.2.3",
    "@tanstack/react-query": "^5.62.8",
    "axios": "^1.19.0",
    "clsx": "^2.1.0",
    "dayjs": "^1.11.9",
    "framer-motion": "^11.2.6",
    "i18next": "^23.16.5",
    "i18next-icu": "^2.3.0",
    "i18next-resources-to-backend": "^1.2.1",
    "intl-messageformat": "^10.7.6",
    "lodash": "^4.18.1",
    "qs": "^6.15.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "^15.1.1",
    "react-router-dom": "6.13.0",
    "react-swipeable": "^7.0.1",
    "uuid": "^9.0.0",
    "web-vitals": "^2.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@babel/plugin-transform-modules-commonjs": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@eslint/js": "10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@playwright/test": "^1.49.1",
    "@tanstack/react-query-devtools": "^5.62.8",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/confusing-browser-globals": "^1",
    "@types/eslint-plugin-jsx-a11y": "^6",
    "@types/jsdom": "^30",
    "@types/lodash": "^4.17.25",
    "@types/node": "^22.10.2",
    "@types/qs": "^6.9.7",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/react-i18next": "^8.1.0",
    "@types/react-router-dom": "^5.1.9",
    "@types/react-transition-group": "^4.4.6",
    "@types/uuid": "9.0.7",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/eslint-plugin": "1.6.27",
    "confusing-browser-globals": "^1.0.11",
    "dotenv": "17.4.2",
    "eslint": "10.9.1",
    "eslint-config-prettier": "^8.7.0",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "^7.25.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "eslint-plugin-testing-library": "^7.16.2",
    "exceljs": "4.4.0",
    "globals": "^17.11.0",
    "husky": "^7.0.2",
    "js-yaml": "4.1.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "sass": "1.83.1",
    "typescript": "5.6.3",
    "typescript-eslint": "8.68.0",
    "vite": "7.3.6",
    "vite-plugin-svgr": "4.3.0",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.11",
    "yaml": "^2.3.4"
  },
  "packageManager": "yarn@4.18.0"
}
